{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "allowImportingTsExtensions": true,
    "noEmit": true, "types": ["node", "vite/client"]
  },
  "include": ["src", "server", "tests", "vite.config.ts", "playwright.config.ts"]
}
