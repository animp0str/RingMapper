{
  "name": "ring-mapper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test:static": "npm run build && playwright test -c playwright.static.config.ts"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide": "^0.468.0",
    "three": "^0.186.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.1",
    "@types/three": "^0.186.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
